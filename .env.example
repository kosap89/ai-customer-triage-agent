# AI Customer Message Triage Agent — environment template
# Copy to .env when you add external integrations (not required for v1).

# --- Future: local LLM (Ollama) ---
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# --- Future: cloud LLM providers ---
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# --- Future: n8n webhook ---
# N8N_WEBHOOK_URL=https://your-n8n-instance/webhook/customer-triage

# --- Future: Gmail / Google Sheets / CRM ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# CRM_API_URL=

# Default language for reply drafts (v1 uses Finnish)
REPLY_LANGUAGE=fi
