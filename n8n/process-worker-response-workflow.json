    {
      "parameters": {
        "jsCode": "const currentRank = $json.currentCandidateRank;\nconst candidates = $json.rankedCandidates;\n\nconst nextCandidate = candidates.find(\n  candidate => candidate.rank === currentRank + 1\n);\n\nif (!nextCandidate) {\n  return [{\n    json: {\n      status: \"no_more_candidates\",\n      shiftId: $json.shiftId\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    status: \"next_candidate_selected\",\n    shiftId: $json.shiftId,\n    previousCandidate: $json.candidateName,\n    candidateName: nextCandidate.name,\n    candidateScore: nextCandidate.score,\n    candidateRank: nextCandidate.rank\n  }\n}];"
      },
